{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "training-camp-psi.vercel.app" }], "destination": "https://camp.wexpandmx.com/:path*", "permanent": true },
    { "source": "/web", "destination": "/web/hub" },
    { "source": "/app", "destination": "/app/hub" },
    { "source": "/web/cv-vestidor", "destination": "/cv/" },
    { "source": "/web/cv-resultado", "destination": "/cv/" },
    { "source": "/app/cv-vestidor", "destination": "/cv/" },
    { "source": "/app/cv-resultado", "destination": "/cv/" }
  ],
  "functions": {
    "api/cv-coach.js": { "maxDuration": 60 },
    "api/cv-traducir.js": { "maxDuration": 60 },
    "api/cancha-turno.js": { "maxDuration": 60 },
    "api/cancha-evaluar.js": { "maxDuration": 60 },
    "api/cv-leer.js": { "maxDuration": 60 },
    "api/voz.js": { "maxDuration": 30 },
    "api/orquestador.js": { "maxDuration": 300 }
  },
  "headers": [
    { "source": "/panel/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ],
  "crons": [
    { "path": "/api/orquestador", "schedule": "17 13 * * *" }
  ]
}
